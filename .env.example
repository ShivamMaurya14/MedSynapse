# Local SQLite feature store. Use an absolute path to place it elsewhere.
MEDSYNAPSE_DATABASE_PATH=data/medsynapse.db
# Local Ollama model used after OCR for structured clinical extraction.
GEMMA_BASE_URL=http://127.0.0.1:11434
GEMMA_MODEL=gemma3:4b
# Local CPU inference can take longer after a cold model load.
GEMMA_TIMEOUT_SECONDS=180
# Groq is called only after a clinician approves the model output and explanation.
# Copy this file to .env, then add your Groq API key. Never commit the .env file.
# Never send identifiable patient information unless your privacy/compliance controls permit it.
LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=30
